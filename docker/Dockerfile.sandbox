FROM node:22-alpine

# Set non-root working environment
WORKDIR /sandbox

# Install core tools
RUN apk add --no-cache git bash curl
RUN npm install -g pnpm turbo

# Restrict container privileges
USER node

# Healthcheck & entrypoint
CMD ["sh", "-c", "echo 'BreakGuard Sandbox Ready' && tail -f /dev/null"]
