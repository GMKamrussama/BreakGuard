blob-report/

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local
*.pem
*.key
*.cert

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

