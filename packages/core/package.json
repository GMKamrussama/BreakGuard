{
  "name": "@breakguard/core",
  "version": "1.0.0",
  "description": "Unified core engine for BreakGuard: AST scanning, lockfile parsing, and risk calculations",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@breakguard/ast-scanner": "workspace:*",
    "@breakguard/core-types": "workspace:*",
    "@breakguard/lockfile-parser": "workspace:*",
    "@breakguard/risk-engine": "workspace:*",
    "tinyglobby": "^0.2.12"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
